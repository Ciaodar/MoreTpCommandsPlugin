<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Subnautica.MoreTpCommands</AssemblyName>
    <RootNamespace>Subnautica.MoreTpCommands</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>mete &amp; Antigravity</Authors>
    <Company>BOT Benson Community</Company>
    <Product>Subnautica Below Zero Multiplayer More TP Commands Plugin</Product>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="MoreTpCommandsPlugin.Tests\**" />
    <None Remove="MoreTpCommandsPlugin.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>Libs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>Libs\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>Libs\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Subnautica.API">
      <HintPath>Libs\Subnautica.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Subnautica.Client">
      <HintPath>Libs\Subnautica.Client.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Subnautica.Events">
      <HintPath>Libs\Subnautica.Events.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Subnautica.Network">
      <HintPath>Libs\Subnautica.Network.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Subnautica.Server">
      <HintPath>Libs\Subnautica.Server.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>Libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>Libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>Libs\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>Libs\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)..\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AppData)\.botbenson\Subnautica Below Zero\Game\Plugins" Condition="Exists('$(AppData)\.botbenson\Subnautica Below Zero\Game\Plugins')" />
  </Target>

</Project>
